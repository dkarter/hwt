---
import "../styles/site.css";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Not found · hwt</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="not-found">
    <main>
      <span class="feature-number">404</span>
      <h1>Worktree not found.</h1>
      <p>The page may have moved, but the docs are still attached.</p>
      <div class="actions">
        <a class="primary" href="/docs/">Open the docs <span>→</span></a>
        <a class="secondary" href="/">Return home</a>
      </div>
    </main>
  </body>
</html>
