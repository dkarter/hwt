---
import "../styles/site.css";

const base = `${import.meta.env.BASE_URL.replace(/[/]$/, "")}/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Not found · hwt</title>
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body class="not-found">
    <main>
      <span class="feature-number">404</span>
      <h1>Worktree not found.</h1>
      <p>The page may have moved, but the docs are still attached.</p>
      <div class="actions">
        <a class="primary" href={`${base}docs/`}>Open the docs <span>→</span></a>
        <a class="secondary" href={base}>Return home</a>
      </div>
    </main>
  </body>
</html>
