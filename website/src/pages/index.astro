---
import "../styles/site.css";
import { codeToHtml } from "shiki";
import WorktreeComparison from "../components/WorktreeComparison.astro";

const configExample = [
  "# .herdr-worktree.yaml",
  "agent: opencode --port",
  "worktree_dir: ../",
  "worktree_naming: full",
  "",
  "files:",
  "  copy:",
  "    - .env.local",
  "    - path: node_modules",
  "      symlink: true",
  "",
  "post_create:",
  "  - mise install",
].join("\n");
const highlightedConfig = await codeToHtml(configExample, {
  lang: "yaml",
  theme: "catppuccin-mocha",
});

const features = [
  {
    number: "01",
    title: "One command, every rule.",
    body:
      "Apply branch naming and checkout placement, then transfer files and finish setup before handing back the workspace.",
    command: "hwt create -b feat/fast-path",
  },
  {
    number: "02",
    title: "Built for agents.",
    body:
      "Machine-readable output returns workspace, pane, checkout, branch, and copied-file details without screen scraping.",
    command: "hwt create -b fix/race --json",
  },
  {
    number: "03",
    title: "Fast by policy.",
    body:
      "Copy normally, clone on APFS, or symlink heavyweight dependencies. Choose once globally and override per repository.",
    command: "copy_on_write: true",
  },
];

const demoWorkers = [
  {
    label: "auth",
    branch: "feat/auth",
    path: "../hwt-feat-auth",
    workspace: "wA1",
    step: "step-one",
    commandStep: "command-one",
    workerStep: "worker-one",
  },
  {
    label: "api",
    branch: "feat/api",
    path: "../hwt-feat-api",
    workspace: "wA2",
    step: "step-two",
    commandStep: "command-two",
    workerStep: "worker-two",
  },
  {
    label: "docs",
    branch: "feat/docs",
    path: "../hwt-feat-docs",
    workspace: "wA3",
    step: "step-three",
    commandStep: "command-three",
    workerStep: "worker-three",
  },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="hwt removes the setup friction from Herdr Git worktrees for people and coding agents."
    />
    <meta name="theme-color" content="#151619" />
    <meta property="og:title" content="hwt: your next worktree, ready for work." />
    <meta
      property="og:description"
      content="Turn a Git branch into a configured Herdr workspace with files copied, dependencies linked, and setup finished."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hwt.doriankarter.com/" />
    <meta property="og:site_name" content="hwt" />
    <meta property="og:image" content="https://hwt.doriankarter.com/og-image.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="hwt creates a ready-to-work Herdr workspace from a Git branch"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="hwt: your next worktree, ready for work." />
    <meta
      name="twitter:description"
      content="Turn a Git branch into a configured Herdr workspace with files copied, dependencies linked, and setup finished."
    />
    <meta name="twitter:image" content="https://hwt.doriankarter.com/og-image.png" />
    <meta
      name="twitter:image:alt"
      content="hwt creates a ready-to-work Herdr workspace from a Git branch"
    />
    <link rel="canonical" href="https://hwt.doriankarter.com/" />
    <title>hwt: your next worktree, ready for work.</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <div class="page-grid" aria-hidden="true"></div>
    <header class="nav shell">
      <a class="brand" href="/" aria-label="hwt home">
        <span class="mark"><i></i><i></i></span>
        <strong>hwt</strong>
      </a>
      <nav aria-label="Main navigation">
        <a href="/docs/">Docs</a>
        <a href="https://github.com/dkarter/hwt">GitHub</a>
        <a class="nav-cta" href="/#overview">Overview</a>
      </nav>
    </header>

    <main>
      <section class="hero shell">
        <div class="eyebrow"><span></span> Frictionless Herdr worktrees</div>
        <h1><span class="hero-line">Your next worktree,</span><br /><em>ready for work.</em></h1>
        <p class="lede">
          <strong>hwt removes the friction from Git worktrees.</strong> Turn a branch into a
          configured Herdr workspace with files copied, dependencies linked, and setup finished. The
          same result for you and every agent.
        </p>
        <div class="actions">
          <a class="primary" href="/docs/quick-start/">Create a worktree <span>→</span></a>
          <a class="secondary" href="/docs/">Read the docs</a>
        </div>

        <div
          class="herdr-demo"
          role="img"
          aria-label="Animated Herdr workspace showing OpenCode creating three hwt worktrees and starting agents in separate workspaces"
        >
          <div class="demo-visual" aria-hidden="true">
            <div class="demo-bar">
              <span class="lights"><i></i><i></i><i></i></span>
              <span>hwt · coordinator</span>
              <span>herdr</span>
            </div>
            <aside class="demo-sidebar">
              <b>spaces</b>
              <div class="space parent-space">
                <i class="space-status"></i><span>hwt<small>main</small></span><b>⌄</b>
              </div>
              <div class="worktree-list">
                {
                  demoWorkers.map((worker) => (
                    <div class:list={["space", "child-space", "demo-step", worker.step]}>
                      <i class={worker.workerStep}></i><span>{worker.label}</span>
                    </div>
                  ))
                }
              </div>
              <div class="agent-label">agents <span>status</span></div>
              <div class="agent-row">
                <i class="coordinator-status"></i>
                <span>
                  coordinator
                  <span class="coordinator-state">
                    <small class="coordinator-working">working</small>
                    <small class="coordinator-done">done</small>
                  </span>
                </span>
              </div>
              {
                demoWorkers.map((worker) => (
                  <div class:list={["agent-row", "demo-step", worker.workerStep]}>
                    <i class={worker.workerStep}></i><span>{worker.label}<small
                      >working</small></span>
                  </div>
                ))
              }
            </aside>
            <div class="demo-panes">
              <section class="coordinator-pane demo-pane">
                <div class="pane-title"><span>▣ opencode</span><b>coordinator</b></div>
                <div class="pane-content">
                  <p>
                    <strong>❯</strong> Use the coordinator skill to split auth, API, and docs work.
                  </p>
                  <p class="agent-copy demo-step intro-step">
                    ● Creating isolated Herdr workspaces.
                  </p>
                  {
                    demoWorkers.map((worker) => (
                      <>
                        <p class:list={["command", "demo-step", worker.commandStep]}>
                          <b>$</b> hwt create -b {worker.branch} --base main
                        </p>
                        <p class:list={["result", "demo-step", worker.step]}>
                          Created {worker.branch} at {worker.path} <span>(workspace {
                              worker.workspace
                            })</span>
                        </p>
                      </>
                    ))
                  }
                  <p class="agent-copy demo-step launch-step">
                    ● Worktrees ready. Starting OpenCode in each workspace.
                  </p>
                  <p class="agent-copy demo-step final-step">● Three agents working in parallel.</p>
                  <p class="switch-note demo-step final-step">
                    Select a worktree in the sidebar to switch to its agent.
                  </p>
                </div>
                <div class="pane-foot">~/code/hwt <b>main</b> · ctrl+p commands</div>
              </section>
            </div>
          </div>
        </div>
      </section>

      <section class="manifesto shell">
        <p class="section-label">The contract</p>
        <div>
          <h2>Worktrees should start with context, <em>not chores.</em></h2>
          <p>
            A checkout is only the start. The files it depends on should be present, setup should be
            finished, and the workspace should be ready for a person or agent to pick up.
          </p>
          <p>
            Agents shouldn't spend expensive tokens just to re-install dependencies or re-run setup.
            People shouldn't have to remember to copy files or run scripts. hwt ensures that every
            worktree is ready for work.
          </p>
        </div>
      </section>

      <section class="comparison-section shell" id="overview">
        <div class="comparison-intro">
          <div>
            <p class="section-label">Before and after</p>
            <h2>Herdr creates the checkout.<br /><em>hwt makes it ready.</em></h2>
          </div>
          <p>
            Compare the same Elixir and TypeScript repository with Herdr alone or with hwt policy.
            Run the simulation to see custom placement, naming, and local context arrive.
          </p>
        </div>
        <WorktreeComparison />
        <p class="comparison-footnote">
          <sup>*</sup> Herdr can react to <code>worktree.created</code>{" "}with a{" "}<a
            href="https://herdr.dev/docs/plugins/#manifest"
          >plugin event hook</a>. That requires authoring or installing a plugin and configuring its
          command; Herdr plugins are enabled globally for the current user rather than per
          repository. hwt keeps{" "}
          <code>post_create</code>{" "}alongside the repository's other worktree policy.
        </p>
      </section>

      <section class="features shell">
        {
          features.map((feature) => (
            <article>
              <span class="feature-number">{feature.number}</span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
              <code>{feature.command}</code>
            </article>
          ))
        }
      </section>

      <section class="plugin-section shell">
        <div class="plugin-copy">
          <div class="plugin-kicker">
            <p class="section-label">Herdr plugin</p>
            <span>experimental</span>
          </div>
          <h2>Create worktrees<br /><em>without leaving Herdr.</em></h2>
          <p>
            Open a polished branch prompt from your Herdr keybindings. Name the worktree, fuzzy-find
            its base branch, and let hwt apply the repository's complete ready-state policy.
          </p>
          <a href="/docs/herdr-plugin/">Explore the Herdr plugin →</a>
        </div>

        <div
          class="plugin-demo"
          role="img"
          aria-label="Herdr New Worktree popup showing the hwt branch prompt in Vim normal mode"
        >
          <div class="plugin-grid" aria-hidden="true"></div>
          <div class="plugin-popup" aria-hidden="true">
            <div class="plugin-popup-title"><span>New Worktree</span><i></i></div>
            <div class="plugin-popup-body">
              <p class="plugin-field-label">Branch name</p>
              <div class="plugin-input"><b>&gt;</b><span>feat/plugin-ui</span><i></i></div>
              <div class="plugin-mode-line">
                <strong>NORMAL</strong>
                <span>i insert</span><i></i><span>esc esc cancel</span>
              </div>
            </div>
            <div class="plugin-popup-foot">
              <span>hwt.worktrees.new</span><b>enter submit</b>
            </div>
          </div>
        </div>
      </section>

      <section class="config shell">
        <div>
          <p class="section-label">Repository policy</p>
          <h2>Describe the ready state.</h2>
          <p>
            Commit one small YAML file. hwt resolves it with your global defaults, validates every
            path, and performs the work in a predictable order.
          </p>
          <a href="/docs/configuration/">Explore configuration →</a>
        </div>
        <Fragment set:html={highlightedConfig} />
      </section>

      <section class="closing shell">
        <div class="closing-mark"><span class="mark"><i></i><i></i></span></div>
        <h2>Branch. Build. Leave the setup behind.</h2>
        <p>Install hwt with mise and create your first configured Herdr worktree.</p>
        <div class="install-command"><code>mise use -g github:dkarter/hwt</code></div>
      </section>
    </main>

    <footer class="shell">
      <a class="brand" href="/"><span class="mark"><i></i><i></i></span><strong>hwt</strong></a>
      <span>Frictionless Herdr worktree orchestration.</span>
      <div>
        <a href="/docs/">Docs</a><a href="https://github.com/dkarter/hwt">GitHub</a><span>MIT</span>
      </div>
    </footer>
  </body>
</html>
