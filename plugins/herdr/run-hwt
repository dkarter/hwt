#!/bin/sh
set -eu

development_hwt=${HERDR_PLUGIN_ROOT:-.}/../../hwt
if [ -n "${HWT_BIN_PATH:-}" ]; then
  hwt_bin=$HWT_BIN_PATH
elif [ -x "$development_hwt" ]; then
  hwt_bin=$development_hwt
else
  hwt_bin=hwt
fi

entrypoint=${1:-}
if [ -z "$entrypoint" ] || ! "$hwt_bin" "$entrypoint" --help >/dev/null 2>&1; then
  if [ -z "${HWT_BIN_PATH:-}" ] && [ -n "$entrypoint" ] && command -v mise >/dev/null 2>&1; then
    mise_hwt=$(mise which hwt 2>/dev/null || true)
    if [ -n "$mise_hwt" ] && [ -x "$mise_hwt" ] && "$mise_hwt" "$entrypoint" --help >/dev/null 2>&1; then
      hwt_bin=$mise_hwt
    fi
  fi
  if ! "$hwt_bin" "$entrypoint" --help >/dev/null 2>&1; then
    printf 'This HWT plugin requires a newer hwt binary.\n\n' >&2
    printf 'Resolved binary: %s\n' "$hwt_bin" >&2
    printf 'Update hwt, then reopen this action.\n\n' >&2
    printf 'Press Enter to close.\n' >&2
    read -r _ || true
    exit 1
  fi
fi

exec "$hwt_bin" "$@"
